@model iTextDesignerWithGUI.Models.ORKidsDelegAssessmentModels.ORKidsDelegAssessmentInstance
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@Model.Model.Name - Assessment Instance</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="globalStyles.css" rel="stylesheet">
</head>
<body>
<div class="container">
<header class="my-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1>@Model.Model.Name</h1>
        <div class="graphic">
            <!-- Replace with your actual image path -->
            <img src="/path/to/logo.png" alt="Logo">
        </div>
    </div>
    <p class="lead">@Model.Model.Description</p>
</header>

<section class="mb-4">
    <h2>Assessment Details</h2>
    <ul class="list-unstyled">
        <li><strong>ID:</strong> @Model.Model.Id</li>
        <li><strong>Created At:</strong> @Model.Model.CreatedAt</li>
        <li><strong>Status:</strong> @(Model.Model.IsActive ? "Active" : "Inactive")</li>
    </ul>
</section>

<section class="mb-4">
    <h2>Sections</h2>
@if(Model.Properties?.Sections != null && Model.Properties.Sections.Any())
{
    foreach(var section in Model.Properties.Sections)
    {
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <h3 class="h5 mb-0">@section.Title</h3>
            </div>
            <div class="card-body">
            @if(section.Fields != null && section.Fields.Any())
            {
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Field Name</th>
                            <th>Type</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach(var field in section.Fields)
                    {
                        <tr>
                            <td>@field.Name</td>
                            <td>@field.Type</td>
                            <td>@field.Value</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <p>No fields available in this section.</p>
            }
            </div>
        </div>
    }
}
else
{
    <p>No sections available.</p>
}
</section>

<footer class="text-end mt-4">
    <small>&copy; @(DateTime.Now.Year) Assessment Application</small>
</footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
