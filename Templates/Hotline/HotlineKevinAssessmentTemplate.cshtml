@model iTextDesignerWithGUI.Models.HotlineKevinAssessmentModels.HotlineKevinAssessmentInstance
@using System
@using System.Linq
@using System.Collections.Generic

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Model?.Name ?? "HotlineKevinAssessment Report")</title>
    <link href="globalStyles.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <!-- Header with Title and Optional Graphic -->
        <header>
            <div class="title">@Model.Model?.Name</div>
            <div class="graphic">
                <!-- Graphic placeholder if needed -->
            </div>
        </header>
        
        <!-- Assessment Details -->
        <div>
            <h2>Assessment Details</h2>
            <p><strong>Description:</strong> @Model.Model?.Description</p>
            <p>
                <strong>Created At:</strong> 
                @(System.DateTime.TryParse(Model.Model?.CreatedAt, out DateTime createdDate) 
                    ? createdDate.ToString("yyyy-MM-dd") 
                    : "N/A")
            </p>
            <p><strong>Active:</strong> @(Model.Model?.IsActive == true ? "Yes" : "No")</p>
        </div>

        <!-- Sections and Fields -->
        @{
            // Retrieve sections safely from the model
            var sections = Model.Properties?.Sections;
        }
        @if(sections != null && sections.Any())
        {
            foreach(var sect in sections)
            {
                <div class="assessment-section">
                    <h2>@sect.Title</h2>
                    @if(sect.Fields != null && sect.Fields.Any())
                    {
                        <table class="section-table">
                            <thead>
                                <tr>
                                    <th>Field Name</th>
                                    <th>Type</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var field in sect.Fields)
                                {
                                    <tr>
                                        <td>@field.Name</td>
                                        <td>@field.Type</td>
                                        <td>
                                            @if(!String.IsNullOrEmpty(field.Type) && field.Type.ToLower() == "date")
                                            {
                                                @(System.DateTime.TryParse(field.Value?.ToString(), out DateTime fieldDate)
                                                    ? fieldDate.ToString("yyyy-MM-dd")
                                                    : "Invalid Date")
                                            }
                                            else if(!String.IsNullOrEmpty(field.Type) && 
                                                (field.Type.ToLower() == "number" || field.Type.ToLower() == "currency"))
                                            {
                                                @(System.Decimal.TryParse(field.Value?.ToString(), out decimal fieldNumber)
                                                    ? fieldNumber.ToString()
                                                    : field.Value?.ToString())
                                            }
                                            else if(!String.IsNullOrEmpty(field.Type) && field.Type.ToLower() == "checkbox")
                                            {
                                                @(bool.TryParse(field.Value?.ToString(), out bool isChecked) && isChecked ? "Yes" : "No")
                                            }
                                            else
                                            {
                                                @field.Value
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No fields available in this section.</p>
                    }
                </div>
            }
        }
        else
        {
            <p>No sections available.</p>
        }

        <!-- Footer -->
        <footer>
            <p>Generated on @(System.DateTime.Now.ToString("yyyy-MM-dd HH:mm"))</p>
        </footer>
    </div>
</body>
</html>
